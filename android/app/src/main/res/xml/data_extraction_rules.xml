<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: токен сессии не уходит ни в облачную копию, ни при переносе на новое устройство.
     База WorkManager тоже: в задачах фоновой отправки лежит заголовок Authorization с этим токеном. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pushup_secure_token.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pushup_secure_token.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </device-transfer>
</data-extraction-rules>
