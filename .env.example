# Example env (DO NOT put secrets here)
DATABASE_URL=postgresql://postgres:postgres@db:5432/pushup_tracker
NEXT_PUBLIC_APP_NAME=PushUp
APP_URL=https://example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=secret
SMTP_SECURE=false
MAIL_FROM=PushUp Tracker <mailer@example.com>
# Почтовый провайдер: resend | smtp. Если не задан — уведомления идут по SMTP,
# обратная связь предпочитает Resend (при наличии RESEND_API_KEY).
MAIL_PROVIDER=
# Домен в MAIL_FROM должен быть верифицирован в Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Куда падает обратная связь и какой меткой помечена тема письма.
FEEDBACK_TO=you@example.com
FEEDBACK_PROJECT_LABEL=PushUp Tracker
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=YOUR_BASE64URL_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_BASE64URL_PRIVATE_KEY
# Фоновый планировщик (напоминания, итоги недели, чистка БД) стартует только при SCHEDULER_ENABLED=1.
# Флаг задаётся только в docker-compose.prod.yml (сервис web); локально оставь пустым.
SCHEDULER_ENABLED=
# Telegram-бот (@BotFather): без токена раздел и канал Telegram скрыты.
# Имя бота без @ — для ссылки привязки t.me/<имя>?start=<код>.
# Секрет вебхука: 16–256 символов A–Z a–z 0–9 _ -; без него вебхук выключен.
# База API — на случай блокировок (по умолчанию https://api.telegram.org).
# Установка вебхука: npx tsx --env-file=.env scripts/telegram-set-webhook.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=
# Origin'ы нативного приложения (WebView), которым API отдаёт CORS-заголовки; через запятую.
# Пусто — capacitor://localhost (iOS) и https://localhost (Android).
NATIVE_APP_ORIGINS=
# Адрес сервера для нативной сборки интерфейса (npm run build:native)
NATIVE_API_BASE=
# Нативные пуши приложений. iOS — APNs: ключ .p8 (Keys в Apple Developer), id ключа, Team ID,
# bundle id приложения; ключ одной строкой с \n. APNS_PRODUCTION=1 — боевой APNs (сборки из App Store / TestFlight).
# Android — FCM HTTP v1: сервисный аккаунт проекта Firebase (project_id, client_email, private_key из JSON).
# Пусто — канал выключен, в профиле приложения «станут доступны после публикации».
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_PRODUCTION=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
