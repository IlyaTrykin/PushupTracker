generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  language          String    @default("ru")
  gender            String?
  birthDate         DateTime?
  weightKg          Int?
  avatarPath        String?
  // Упражнения на экране тренировки; пусто — порядок каталога по умолчанию.
  favoriteExercises String[]  @default([])
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?     @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers      User[]    @relation("UserDeletedBy")

  workouts                Workout[]
  friendships             Friendship[]           @relation("UserFriendships")
  friendsWith             Friendship[]           @relation("FriendFriendships")
  sessions                Session[]
  challengesCreated       Challenge[]            @relation("UserCreatedChallenges")
  challengeParticipations ChallengeParticipant[]
  Notification            Notification[]
  isAdmin                 Boolean                @default(false)

  profileHistory           UserProfileHistory[]     @relation("UserProfileHistoryUser")
  profileChangesMade       UserProfileHistory[]     @relation("UserProfileChangedBy")
  passwordResetTokens      PasswordResetToken[]
  friendFollows            FriendFollow[]           @relation("FriendFollowFollower")
  followedBy               FriendFollow[]           @relation("FriendFollowFriend")
  comparisonHides          FriendComparisonHide[]   @relation("ComparisonHideOwner")
  comparisonHiddenBy       FriendComparisonHide[]   @relation("ComparisonHideFriend")
  workoutReactions         WorkoutReaction[]
  blocksMade               UserBlock[]              @relation("UserBlockBlocker")
  blockedBy                UserBlock[]              @relation("UserBlockBlocked")
  reportsMade              UserReport[]             @relation("UserReportReporter")
  reportsReceived          UserReport[]             @relation("UserReportTarget")
  pushSubscriptions        PushSubscription[]
  pushDevices              PushDevice[]
  ownedGroups              Group[]                  @relation("GroupOwner")
  groupMemberships         GroupMembership[]
  groupJoinRequests        GroupJoinRequest[]
  groupAuditLogsAuthored   GroupAuditLog[]          @relation("GroupAuditActor")
  groupAuditLogsTargeting  GroupAuditLog[]          @relation("GroupAuditTargetUser")
  /// deprecated: replaced by NotificationPreference; kept to preserve data.
  pushFriendRequest        Boolean                  @default(true)
  /// deprecated: replaced by NotificationPreference; kept to preserve data.
  pushChallengeInvite      Boolean                  @default(true)
  /// deprecated: replaced by NotificationPreference; kept to preserve data.
  pushChallengeRankChange  Boolean                  @default(true)
  notificationPreferences  NotificationPreference[]
  trainingPrograms         TrainingProgram[]
  assignedTrainingPrograms TrainingProgram[]        @relation("TrainingProgramAssignedByUser")

  // IANA time zone of the user's calendar days (see src/lib/calendar-day.ts).
  timeZone          String    @default("Europe/Moscow")
  // Daily goal in points; null = disabled.
  dailyGoalPoints   Int?
  // Local reminder time "HH:MM"; null = default.
  dailyReminderTime String?
  telegramChatId    String?   @unique
  telegramLinkedAt  DateTime?

  achievements      UserAchievement[]
  telegramLinkCodes TelegramLinkCode[]

  // Personal invite link code (/invite/<code>); created on first request.
  inviteCode   String? @unique
  // Who invited this user (via an invite link); null for organic signups.
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")
  // Where the signup came from: "invite", "utm:<source>", "ref:<value>" or "direct".
  signupSource String?
  // utm_* parameters seen before signup, as { utm_source: "...", ... }.
  signupUtm    Json?

  @@index([deletedAt])
  @@index([createdAt])
  @@index([referredById])
}

model Group {
  id        String    @id @default(uuid())
  name      String
  ownerId   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner           User               @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships     GroupMembership[]
  joinRequests    GroupJoinRequest[]
  inviteLink      GroupInviteLink?
  auditLogs       GroupAuditLog[]
  challenges      Challenge[]
  managedPrograms TrainingProgram[]  @relation("GroupManagedPrograms")
  goals           GroupGoal[]

  @@index([ownerId, createdAt])
  @@index([deletedAt, createdAt])
}

model GroupMembership {
  id             String    @id @default(uuid())
  groupId        String
  userId         String
  status         String    @default("active") // active | left | removed
  includeInStats Boolean   @default(true)
  joinedAt       DateTime?
  leftAt         DateTime?
  removedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status, updatedAt])
  @@index([groupId, status, updatedAt])
}

model GroupJoinRequest {
  id           String    @id @default(uuid())
  groupId      String
  userId       String
  status       String    @default("pending") // pending | approved | rejected
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status, createdAt])
  @@index([userId, status, createdAt])
}

model GroupInviteLink {
  id        String   @id @default(uuid())
  groupId   String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupAuditLog {
  id           String   @id @default(cuid())
  groupId      String
  actorId      String?
  targetUserId String?
  action       String
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor      User? @relation("GroupAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("GroupAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([targetUserId, createdAt])
}

model Workout {
  id                String            @id @default(uuid())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  date              DateTime
  time              DateTime          @default(now())
  exerciseType      String
  // Итог подхода; у упражнений на одну руку — сумма левой и правой.
  reps              Int
  // Вес снаряда (кг) для упражнений со снарядом.
  loadKg            Float?
  // Раскладка по рукам для упражнений, выполняемых поочерёдно каждой рукой.
  repsLeft          Int?
  repsRight         Int?
  // Optional duration of the set (cardio: total time), seconds.
  durationSeconds   Int?
  // Client-generated idempotency key: a retried POST returns the existing workout.
  clientRequestId   String?
  trainingSessionId String?
  trainingSession   TrainingSession?  @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  reactions         WorkoutReaction[]
  achievements      UserAchievement[]

  @@unique([userId, clientRequestId])
  @@index([userId, exerciseType, time])
  @@index([userId, time])
  @@index([trainingSessionId])
}

model WorkoutReward {
  id              String   @id @default(cuid())
  message         String
  minPointsTenths Int      @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([minPointsTenths])
}

model WorkoutReaction {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([workoutId, updatedAt])
  @@index([userId])
}

model Friendship {
  id        String   @id @default(uuid())
  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  friend    User     @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)
  friendId  String
  status    String   @default("accepted") // accepted | pending
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model FriendFollow {
  id         String   @id @default(cuid())
  followerId String
  friendId   String
  createdAt  DateTime @default(now())

  follower User @relation("FriendFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  friend   User @relation("FriendFollowFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([followerId, friendId])
  @@index([friendId])
}

/// A friend the user hid from their comparison table on /friends; the friendship stays.
model FriendComparisonHide {
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("ComparisonHideOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("ComparisonHideFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 (hex) of the cookie token; the raw token is not stored.
  tokenHash String   @unique
  // Legacy raw token; nulled by 20261009120000_audit_and_features.
  token     String?  @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
}

model Challenge {
  id String @id @default(uuid())

  creatorId String
  creator   User    @relation("UserCreatedChallenges", fields: [creatorId], references: [id])
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  name         String
  exerciseType String
  mode         String   @default("most") // most | target | daily_min | sets_min
  targetReps   Int?
  startDate    DateTime
  endDate      DateTime

  createdAt DateTime @default(now())

  participants ChallengeParticipant[]

  @@index([groupId, createdAt])
}

model ChallengeParticipant {
  id String @id @default(uuid())

  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  userId String
  status String @default("pending") // pending | accepted
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // challenge_invite | challenge_accept | challenge_decline
  title     String
  body      String?
  link      String? // например /challenges/<id>
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model UserProfileHistory {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserProfileHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   User?   @relation("UserProfileChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())
  changes   Json

  @@index([userId, changedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

/// Native push token of the iOS (APNs) / Android (FCM) app; one row per device token.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // 'ios' | 'android'
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType       String
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(false)
  telegramEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, eventType])
  @@index([eventType])
}

model TrainingProgram {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedByGroupId   String?
  managedByGroup     Group?    @relation("GroupManagedPrograms", fields: [managedByGroupId], references: [id], onDelete: SetNull)
  assignedByUserId   String?
  assignedByUser     User?     @relation("TrainingProgramAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  exerciseType       String
  goalType           String
  targetReps         Int?
  durationWeeks      Int
  frequencyPerWeek   Int
  baselineMaxReps    Int
  ageYears           Int
  weightKg           Int
  sex                String
  startDate          DateTime  @default(now())
  status             String    @default("active") // active | inactive | needs_retest | completed
  needsRetest        Boolean   @default(false)
  lastRecalculatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  isActive           Boolean   @default(true)

  sessions TrainingSession[]

  @@index([userId, isActive, createdAt])
  @@index([managedByGroupId, userId, isActive])
}

model TrainingSession {
  id             String          @id @default(cuid())
  programId      String
  program        TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber     Int
  sessionNumber  Int
  scheduledAt    DateTime
  isFinalTest    Boolean         @default(false)
  startedAt      DateTime?
  completed      Boolean         @default(false)
  completedAt    DateTime?
  shiftedCount   Int             @default(0)
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  sets     TrainingSet[]
  workouts Workout[]

  @@unique([programId, sessionNumber])
  @@index([programId, scheduledAt])
  @@index([programId, completed, scheduledAt])
}

model TrainingSet {
  id          String          @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setNumber   Int
  targetReps  Int
  actualReps  Int?
  restSeconds Int
  completedAt DateTime?
  isKeySet    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@unique([sessionId, setNumber])
  @@index([sessionId, setNumber])
}

model UserAchievement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // badge | record
  code         String
  exerciseType String?
  value        Float?
  workoutId    String?
  workout      Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  achievedAt   DateTime @default(now())
  uniqueKey    String?  @unique

  @@index([userId, achievedAt])
}

model GroupGoal {
  id           String    @id @default(cuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title        String
  targetPoints Int
  exerciseType String?
  startDate    DateTime
  endDate      DateTime
  createdById  String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  deletedAt    DateTime?

  @@index([groupId])
}

model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FriendRequestCooldown {
  requesterId String
  targetId    String
  declinedAt  DateTime @default(now())

  @@id([requesterId, targetId])
}

model NotificationDispatch {
  key       String   @id
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

// Blocking (R33.1): the blocker and the blocked do not see each other in friends' feeds, the league
// and the comparison; requests and invitations between them are refused by the server.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// A report on a user (R33): from the person's profile, a group or a reaction. Read in /admin/reports.
model UserReport {
  id           String   @id @default(uuid())
  reporterId   String
  targetUserId String
  // 'profile' | 'group' | 'reaction'
  context      String
  // group id for 'group', reaction id for 'reaction'
  contextId    String?
  // see REPORT_REASONS in src/lib/reports.ts
  reason       String
  text         String?
  // 'new' | 'reviewed'
  status       String   @default("new")
  createdAt    DateTime @default(now())

  reporter   User @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User @relation("UserReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([reporterId, createdAt])
}
