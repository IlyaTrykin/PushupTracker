# Локальные настройки деплоя для ./deploy.sh.
# Скопируйте в .deploy.env (он в .gitignore) и заполните. Значения в репозиторий не коммитить.
# Сервер, куда деплоить: user@host
DEPLOY_HOST=
# Путь к приватному ssh-ключу (необязательно; без него — ssh-agent / ~/.ssh/config)
DEPLOY_KEY=
# Публичный адрес проверки здоровья, например https://<домен>/api/health
HEALTH_URL=
# Необязательно: каталог проекта на сервере и compose-файл
# REMOTE_DIR=/root/pushup-tracker
# COMPOSE_FILE=docker-compose.prod.yml
